# LLM provider (PydanticAI model string)
# Examples:
#   google-gla:gemini-2.5-flash
#   openai:gpt-4.1-mini
#   ollama:llama3.2
DND_MODEL=google-gla:gemini-2.5-flash

# Provider API keys (set the one your model needs)
DND_GEMINI_API_KEY=
DND_OPENAI_API_KEY=

# Ollama OpenAI-compatible base URL
DND_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Persistence
DND_DATABASE_URL=sqlite:///./data/dnd_agent.db

# API
DND_API_HOST=127.0.0.1
DND_API_PORT=8000

# Memory / agent limits
DND_MEMORY_RECENT_TURNS=8
DND_SUMMARY_EVERY_N_TURNS=5
DND_MAX_TOOL_CALLS_PER_TURN=12
